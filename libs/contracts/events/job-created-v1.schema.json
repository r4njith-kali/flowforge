{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flowforge.io/contracts/events/job-created-v1.schema.json",
  "title": "FlowForge JobCreated v1",
  "type": "object",
  "required": [
    "eventId",
    "eventType",
    "schemaVersion",
    "occurredAt",
    "aggregateId",
    "payload"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "eventType": {
      "const": "JobCreated"
    },
    "schemaVersion": {
      "const": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "aggregateId": {
      "type": "string",
      "format": "uuid"
    },
    "payload": {
      "type": "object",
      "required": [
        "jobId",
        "jobType",
        "status",
        "payload",
        "createdAt",
        "maxAttempts",
        "retryDelaySeconds"
      ],
      "properties": {
        "jobId": {
          "type": "string",
          "format": "uuid"
        },
        "jobType": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "status": {
          "enum": [
            "PENDING",
            "SCHEDULED"
          ]
        },
        "payload": {
          "type": "object"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "scheduledAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "maxAttempts": {
          "type": "integer",
          "minimum": 1
        },
        "retryDelaySeconds": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
